# See https://git-scm.com/docs/gitignore for the pattern syntax.
#
# Generated files that ARE committed (don't ignore them):
#   src/lib/engines/wasm/search.wasm    scripts/build-wasm.sh
#   src/lib/exports/pdf-fonts/*.ttf     scripts/make-pdf-fonts.py
#   public/textures/*.png               scripts/make-textures.py

# ---------------------------------------------------------------- dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------- Next.js and builds
/.next/
/out/
/build
/dist
.vercel
.turbo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------- tests
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---------------------------------------------------------------- WebAssembly build leftovers
# Only search.wasm is kept; clang/LTO temporaries are not.
*.o
*.bc
*.ll
*.wat

# ---------------------------------------------------------------- Python (asset scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------- environment and secrets
.env*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------- logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------- editors and OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------------------------------------------------------------- AI coding tools
# Shared settings (.claude/settings.json, CLAUDE.md, AGENTS.md) are committed;
# personal ones are not.
.claude/settings.local.json
CLAUDE.local.md

# ---------------------------------------------------------------- LaTeX build leftovers
# docs/math/seed-cracker-math.pdf is committed; these are not.
*.aux
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv

# ---------------------------------------------------------------- local scratch
/tmp/
*.local
